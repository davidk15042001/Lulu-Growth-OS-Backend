{
  "name": "lulu-growth-os-backend",
  "version": "1.0.0",
  "description": "Multi-tenant API and PostgreSQL backend for Lulu Growth OS",
  "homepage": "https://github.com/davidk15042001/Lulu-Growth-OS-Backend#readme",
  "bugs": {
    "url": "https://github.com/davidk15042001/Lulu-Growth-OS-Backend/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davidk15042001/Lulu-Growth-OS-Backend.git"
  },
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "nodemon --config nodemon.json",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "tsx src/database/run.ts",
    "start": "node dist/server.js",
    "start:source": "tsx src/server.ts",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "test": "tsx --test --test-force-exit",
    "test:migrations": "tsx scripts/verify-migrations.ts",
    "test:smoke": "node scripts/smoke-built-server.mjs",
    "check": "npm run typecheck && npm run test:migrations && npm test && npm run build && npm run test:smoke"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1111.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.5",
    "openai": "^7.4.0",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.5",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.2",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.4",
    "@types/supertest": "^7.2.1",
    "nodemon": "^3.1.14",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
