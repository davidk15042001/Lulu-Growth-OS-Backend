# Server
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info
FRONTEND_BASE_URL=http://localhost:5173

# Database (Supabase / PostgreSQL connection string)
DATABASE_URL=postgresql://lulu:lulu_dev_password@localhost:5432/lulu_growth_os
DATABASE_SSL=false
DATABASE_POOL_MAX=10
RUN_MIGRATIONS_ON_STARTUP=true
BACKGROUND_WORKERS_ENABLED=true

# Durable PostgreSQL event runtime
EVENT_WORKER_POLL_INTERVAL_MS=5000
EVENT_WORKER_BATCH_SIZE=100
EVENT_WORKER_CONCURRENCY=10
EVENT_WORKER_LEASE_SECONDS=60
AGENT_RUN_WORKER_INTERVAL_MS=10000
AGENT_RUN_WORKER_CONCURRENCY=3
AGENT_RUN_WORKER_LEASE_SECONDS=900
AGENT_RUN_WORKER_MAX_ATTEMPTS=3
CONTENT_WORKER_INTERVAL_MS=15000
CONTENT_JOB_LEASE_SECONDS=1800
CONTENT_JOB_MAX_ATTEMPTS=3

# Auth
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_TTL=24h
REFRESH_TOKEN_TTL_DAYS=30
# Use none when the HTTPS frontend and API are on different sites; use lax when they share a site.
REFRESH_COOKIE_SAME_SITE=lax
BCRYPT_ROUNDS=12
OTP_TTL_MINUTES=10

# Mailcow SMTP email delivery
EMAIL_FROM=Lulu AI <noreply@your-mailcow-domain.com>
MAILCOW_SMTP_HOST=mail.your-mailcow-domain.com
MAILCOW_SMTP_PORT=587
MAILCOW_SMTP_SECURE=false
MAILCOW_SMTP_USER=noreply@your-mailcow-domain.com
MAILCOW_SMTP_PASS=your-mailcow-mailbox-password

# AI provider (choose exactly one provider and configure its key)
AI_PROVIDER=deepseek
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_REASONING_EFFORT=medium
OPENAI_MAX_OUTPUT_TOKENS=4096
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen3.7-plus
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile
AI_REQUEST_TIMEOUT_MS=180000
AI_MAX_RETRIES=1
TRANSLATION_GLOBAL_CHARACTER_LIMIT_PER_HOUR=2000000
WEBSITE_WORKER_INTERVAL_MS=2000
WEBSITE_JOB_LEASE_SECONDS=90
WEBSITE_JOB_MAX_ATTEMPTS=3
ONBOARDING_FILE_CLEANUP_INTERVAL_MINUTES=60

# Pay-as-you-go API and AWS billing (weekly periods close every Monday, Europe/Berlin)
PAYG_BILLING_WORKER_INTERVAL_MINUTES=15
# Actual daily AWS provider cost allocated to one active workspace. Customer price is always exactly 2x.
PAYG_SERVER_COST_USD_PER_DAY=0
PAYG_INVOICE_DAYS_UNTIL_DUE=7

# Reverse proxy (enable on Vercel or another trusted proxy)
TRUST_PROXY=false

# Amazon S3 document storage
AWS_REGION=eu-central-1
AWS_S3_BUCKET=your-private-s3-bucket
AWS_S3_ENDPOINT=
AWS_S3_FORCE_PATH_STYLE=false
# Leave access keys empty when the server uses an IAM instance/task role.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# OAuth provider integrations
# Register the exact callback URLs in each provider portal.
OAUTH_CALLBACK_BASE_URL=https://lulu-ai.cn/api/v1
CALENDAR_GOOGLE_CLIENT_ID=
CALENDAR_GOOGLE_CLIENT_SECRET=
CALENDAR_MICROSOFT_CLIENT_ID=
CALENDAR_MICROSOFT_CLIENT_SECRET=
CALENDAR_MICROSOFT_TENANT=common
# Cal.com API calls are restricted to these exact HTTPS hostnames. Add self-hosted domains explicitly.
CALENDAR_CALCOM_ALLOWED_HOSTS=api.cal.com
CALENDAR_WORKER_INTERVAL_MS=2000
CALENDAR_SYNC_INTERVAL_MINUTES=15
EMAIL_GOOGLE_CLIENT_ID=
EMAIL_GOOGLE_CLIENT_SECRET=
EMAIL_MICROSOFT_CLIENT_ID=
EMAIL_MICROSOFT_CLIENT_SECRET=
EMAIL_MICROSOFT_TENANT=common
EMAIL_SYNC_INTERVAL_MINUTES=15
EMAIL_SYNC_MESSAGE_LIMIT=100

SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_AUTH_URL=https://login.salesforce.com/services/oauth2/authorize
SALESFORCE_TOKEN_URL=https://login.salesforce.com/services/oauth2/token

PIPEDRIVE_CLIENT_ID=
PIPEDRIVE_CLIENT_SECRET=

HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=

META_CLIENT_ID=
META_CLIENT_SECRET=
META_GRAPH_VERSION=v23.0

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

WEBFLOW_CLIENT_ID=
WEBFLOW_CLIENT_SECRET=

WORDPRESS_CLIENT_ID=
WORDPRESS_CLIENT_SECRET=

SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_SCOPES=read_products,read_content

# DataForSEO (preferred: one API key value)
# Supported formats for DATAFORSEO_API_KEY:
# 1) login:password
# 2) base64-encoded Basic auth token
DATAFORSEO_API_KEY=
DATAFORSEO_BASE_URL=https://api.dataforseo.com

# Legacy DataForSEO credentials (optional fallback)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Airwallex Billing Sandbox
AIRWALLEX_CLIENT_ID=
AIRWALLEX_API_KEY=
AIRWALLEX_BASE_URL=https://api.sandbox.airwallex.com
AIRWALLEX_LEGAL_ENTITY_ID=
AIRWALLEX_LINKED_PAYMENT_ACCOUNT_ID=
AIRWALLEX_STARTER_PRICE_ID=
AIRWALLEX_AI_PRICE_ID=
# Recurring Airwallex price with amount 0. Used only to collect/save the Test-plan card.
AIRWALLEX_TEST_PRICE_ID=
BILLING_TEST_PLAN_PASSWORD=
AIRWALLEX_WEBHOOK_SECRET=
AIRWALLEX_WEBHOOK_TOLERANCE_SECONDS=300
AIRWALLEX_LOGIN_AS=
