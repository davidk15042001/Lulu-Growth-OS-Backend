# Server
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info
FRONTEND_BASE_URL=http://localhost:5173

# Database (Supabase / PostgreSQL connection string)
DATABASE_URL=postgresql://lulu:lulu_dev_password@localhost:5432/lulu_growth_os
DATABASE_SSL=false
DATABASE_POOL_MAX=10
RUN_MIGRATIONS_ON_STARTUP=true

# Auth
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_TTL=24h
REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_ROUNDS=12
OTP_TTL_MINUTES=10

# Email (SMTP) configuration
EMAIL_FROM=noreply@yourapp.com
RESEND_API_KEY=your-resend-api-key

# OpenAI Responses API (optional until AI response generation is enabled)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=medium
OPENAI_MAX_OUTPUT_TOKENS=4096

# Reverse proxy (enable on Vercel or another trusted proxy)
TRUST_PROXY=false
